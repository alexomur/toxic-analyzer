{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ModelService": {
    "BaseUrl": "http://localhost:8000/",
    "Timeout": "00:00:10",
    "InternalApiKeyHeaderName": "X-Internal-Api-Key",
    "InternalApiKey": null,
    "MaxConcurrentRequests": 16
  },
  "AnalysisCapture": {
    "Enabled": false,
    "ConnectionString": null,
    "Schema": "public",
    "QueueCapacity": 4096,
    "BatchSize": 128,
    "FlushInterval": "00:00:02"
  },
  "Auth": {
    "Enabled": true,
    "Issuer": "toxic-analyzer",
    "Audience": "toxic-analyzer-api",
    "SigningKey": null,
    "AnonymousCookieName": "ta_actor",
    "SessionCookieName": "ta_session",
    "CsrfCookieName": "ta_csrf",
    "ConnectionString": null,
    "Schema": "public",
    "AdminRole": "admin",
    "TrustedServiceRole": "trusted_service",
    "BrowserSessionLifetime": "7.00:00:00",
    "ServiceAccessTokenLifetime": "00:15:00",
    "LoginMaxFailedAttempts": 5,
    "LoginFailureWindow": "00:15:00",
    "LoginLockoutDuration": "00:10:00",
    "ServiceTokenMaxFailedAttempts": 5,
    "ServiceTokenFailureWindow": "00:15:00",
    "ServiceTokenLockoutDuration": "00:10:00",
    "BootstrapAdminEmail": null,
    "BootstrapAdminPassword": null
  },
  "Frontend": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
